{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "login": false,
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "steps": [
    {
      "step": "activateTheme",
      "themeFolderName": "solo-to-china-child"
    },
    {
      "step": "activatePlugin",
      "pluginName": "SoloToChina Tools",
      "pluginPath": "solo-to-china-tools/solo-to-china-tools.php"
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "SoloToChina",
        "blogdescription": "Practical China travel for independent travelers",
        "show_on_front": "posts"
      }
    }
  ]
}
