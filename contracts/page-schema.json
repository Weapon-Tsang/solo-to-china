                    "default": "context"
                  },
                  "anchor": {
                    "type": "string"
                  },
                  "after_block_id": {
                    "type": "string"
                  }
                }
              },
              "variant": {
                "type": "string",
                "enum": [
                  "evidence",
                  "context",
                  "illustration",
                  "decorative"
                ]
