{
  "required": [
    "metadata",
    "blocks"
  ],
  "contractVersion": "1.0.0",
  "description": "CMS-authored page metadata and ordered content blocks for the SoloToChina frontend.",
  "$id": "https://solotochina.com/contracts/page-schema.json",
  "properties": {
    "metadata": {
      "properties": {
        "slug": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "featuredMediaId": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "seo": {
          "properties": {
            "description": {
              "type": "string"
            },
            "robots": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "canonicalUrl": {
              "type": "string",
              "format": "uri"
            }
          },
          "type": "object",
          "additionalProperties": false
        },
        "taxonomy": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "excerpt": {
          "type": "string"
        },
        "presentation": {
          "properties": {
            "table_of_contents": {
              "type": "boolean",
              "default": false
            },
            "article_hero": {
              "properties": {
                "variant": {
                  "type": "string",
                  "enum": [
                    "default",
                    "attraction",
                    "city",
                    "survival"
                  ]
                }
              },
              "type": "object",
              "required": [
                "variant"
              ],
              "additionalProperties": false
            },
            "share_this_page": {
              "type": "boolean",
              "default": false
            }
          },
          "type": "object",
          "additionalProperties": false
        },
        "contentType": {
          "description": "Taxonomy, not layout. It must never cause the frontend to inject editorial blocks.",
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "pageId": {
          "type": [
            "string",
            "integer"
          ],
          "description": "Stable CMS page identifier."
        },
        "canonicalUrl": {
          "type": "string",
          "format": "uri"
        }
      },
      "type": "object",
      "required": [
        "pageId",
        "title",
        "slug",
        "contentType"
      ],
      "additionalProperties": false
    },
    "blocks": {
      "description": "Array order is the final render order. The frontend must not reorder or inject editorial blocks based on contentType.",
      "type": "array",
      "items": {
        "oneOf": [
          {
            "description": "Standard editable body copy with meaningful inline links.",
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "content"
                ],
                "properties": {
                  "content": {
                    "type": "string",
                    "contentMediaType": "text/html"
                  },
                  "anchor": {
                    "type": "string"
                  }
                }
              },
              "variant": {
                "type": "string",
                "enum": [
                  "default"
                ]
              },
              "type": {
                "const": "paragraph"
              }
            },
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "variant",
              "data"
            ],
            "title": "Paragraph"
          },
          {
            "description": "Creates an article section in the semantic document outline.",
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text",
                  "level"
                ],
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "level": {
                    "type": "integer",
                    "enum": [
                      2,
                      3
                    ]
                  },
                  "anchor": {
                    "type": "string"
                  }
                }
              },
              "variant": {
                "type": "string",
                "enum": [
                  "section",
                  "subsection"
                ]
              },
              "type": {
                "const": "heading"
              }
            },
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "variant",
              "data"
            ],
            "title": "Heading"
          },
          {
            "description": "Presents related items or a meaningful sequence.",
            "properties": {
              "data": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "items"
                ],
                "properties": {
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  "ordered": {
                    "type": "boolean"
                  },
                  "anchor": {
                    "type": "string"
                  }
                }
              },
              "variant": {
                "type": "string",
                "enum": [
                  "unordered",
                  "ordered"
                ]
              },
              "type": {
                "const": "list"
              }
            },
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "variant",
              "data"
            ],
            "title": "List"
          },
          {
